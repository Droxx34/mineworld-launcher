<%# MineWorld (13/11/2026) : écran d'accueil refait selon la maquette v1 (menu à gauche, bannière d'événements,
    mises à jour, « À venir », barre du bas avec JOUER). Les identifiants utilisés par landing.js sont gardés. %>
<div id="landingContainer" style="display: none;">
    <aside id="mwMenu">
        <nav id="mwNav">
            <button class="mwNavItem" data-page="accueil" actif>
                <svg viewBox="0 0 24 24"><path d="M12 3.2 2.6 11h2.6v9.2h5.2v-5.6h3.2v5.6h5.2V11h2.6z"/></svg>
                <span>Accueil</span>
            </button>
            <button class="mwNavItem" data-page="actualites">
                <svg viewBox="0 0 24 24" class="mwTrait"><rect x="3.5" y="4.5" width="17" height="15" rx="2.4"/><path d="M7.5 9.2h9M7.5 12.4h9M7.5 15.6h5.6"/></svg>
                <span>Actualités</span>
                <i class="mwPastille" id="mwPastilleActus" hidden></i>
            </button>
            <button class="mwNavItem" data-page="evenements">
                <svg viewBox="0 0 24 24"><path d="M12 2.8l2.75 5.86 6.35.78-4.68 4.38 1.22 6.3L12 17.02l-5.64 3.1 1.22-6.3L2.9 9.44l6.35-.78z"/></svg>
                <span>Événements</span>
            </button>
            <button class="mwNavItem" data-page="parametres">
                <svg viewBox="0 0 24 24" class="mwTrait"><circle cx="12" cy="12" r="5.6"/><circle cx="12" cy="12" r="1.9" class="mwPlein"/><path d="M12 2.6v3M12 18.4v3M2.6 12h3M18.4 12h3M5.35 5.35l2.12 2.12M16.53 16.53l2.12 2.12M5.35 18.65l2.12-2.12M16.53 7.47l2.12-2.12"/></svg>
                <span><%- lang('landing.settingsTooltip') %></span>
            </button>
        </nav>
        <%# uicore.js pose l'attribut « update » quand une nouvelle version du launcher est prête : le bouton apparaît. %>
        <button id="image_seal_container" title="<%- lang('landing.updateAvailableTooltip') %>">
            <svg viewBox="0 0 24 24" class="mwTrait"><path d="M12 4v11M7 10.5l5 5 5-5M5 19.5h14"/></svg>
            <span>Nouvelle version prête</span>
        </button>
        <div id="mwCompte">
            <div id="avatarContainer"></div>
            <div id="mwCompteTexte">
                <span id="user_text"><%- lang('landing.usernamePlaceholder') %></span>
                <span id="mwCompteBadge" class="mwBadge mwVert">
                    <svg viewBox="0 0 24 24" class="mwTrait"><path d="M5 12.5l4.4 4.4L19 7.4"/></svg>
                    <span id="mwCompteType">Microsoft</span>
                </span>
                <span id="mwCompteAucun">Connexion requise</span>
                <span id="mwCompteOfficiel">Launcher officiel</span>
            </div>
            <button id="avatarOverlay" title="Gérer le compte"><%- lang('landing.usernameEditButton') %></button>
        </div>
    </aside>

    <main id="mwContenu">
        <!-- Accueil -->
        <section class="mwPage" id="mwPage_accueil">
            <div id="mwBanniere">
                <img id="mwBanniereImage" alt="" draggable="false">
                <div id="mwBanniereVoile"></div>
                <div id="mwBanniereTexte">
                    <span id="mwBanniereBadge" class="mwEtiquette"></span>
                    <h1 id="mwBanniereTitre">Bienvenue sur MineWorld</h1>
                    <p id="mwBanniereResume">Les actualités du serveur apparaîtront ici.</p>
                </div>
                <button id="mwBanniereVoir">En savoir plus</button>
                <div id="mwBannierePoints"></div>
            </div>
            <div id="mwDeuxColonnes">
                <div id="mwBlocMajs">
                    <div class="mwEntete">
                        <h2>Dernières mises à jour</h2>
                        <button class="mwLien" data-aller="actualites">Tout voir</button>
                    </div>
                    <div id="mwMajs"></div>
                </div>
                <div id="mwBlocAvenir">
                    <div class="mwEntete">
                        <h2>À venir</h2>
                        <button class="mwLien" data-aller="evenements">Tout voir</button>
                    </div>
                    <div id="mwAvenir"></div>
                </div>
            </div>
        </section>
        <!-- Toutes les actualités -->
        <section class="mwPage" id="mwPage_actualites" hidden>
            <div class="mwEntete mwGrand"><h2>Actualités</h2></div>
            <div class="mwListe" id="mwListeActus"></div>
            <div class="mwEntete mwGrand"><h2>Mises à jour</h2></div>
            <div class="mwListe" id="mwListeMajs"></div>
        </section>
        <!-- Événements -->
        <section class="mwPage" id="mwPage_evenements" hidden>
            <div class="mwEntete mwGrand"><h2>Événements</h2></div>
            <div class="mwListe" id="mwListeEvenements"></div>
        </section>
        <!-- Paramètres MineWorld (les réglages d'origine restent dans « Réglages avancés ») -->
        <section class="mwPage" id="mwPage_parametres" hidden>
            <div class="mwEntete mwGrand"><h2>Paramètres</h2></div>
            <h3 class="mwSousTitre">Lancement du jeu</h3>
            <button class="mwChoix" data-mode="officiel">
                <i class="mwRadio"></i>
                <span class="mwChoixTexte">
                    <span class="mwChoixTitre">Par le launcher officiel de Minecraft <span class="mwPetitBadge mwVert">Disponible</span></span>
                    <span class="mwChoixDetail">MineWorld met tout à jour, puis ouvre le launcher officiel sur le profil MineWorld. Tu cliques sur « Jouer » là-bas.</span>
                </span>
            </button>
            <button class="mwChoix" data-mode="direct">
                <i class="mwRadio"></i>
                <span class="mwChoixTexte">
                    <span class="mwChoixTitre">Directement depuis MineWorld <span class="mwPetitBadge mwVert">Recommandé</span></span>
                    <span class="mwChoixDetail">Un seul clic sur JOUER, avec ton compte Microsoft. Le launcher MineWorld est validé par Microsoft.</span>
                </span>
            </button>
            <h3 class="mwSousTitre">Dossier du profil MineWorld</h3>
            <div class="mwChemin">
                <span id="mwCheminJeu">…</span>
                <button id="mwOuvrirDossier" class="mwBoutonGris">Ouvrir</button>
            </div>
            <p class="mwNote">Tes mondes solo et ton profil Minecraft habituel ne sont pas touchés.</p>
            <h3 class="mwSousTitre">Autres réglages</h3>
            <button id="settingsMediaButton" class="mwBoutonGris mwLarge">Réglages avancés (comptes, mémoire, Java, mises à jour du launcher)</button>
            <h3 class="mwSousTitre">Crédits</h3>
            <div id="mwCredits" class="mwNote">Launcher basé sur Helios Launcher (licence MIT).</div>
        </section>
    </main>

    <footer id="mwBarre">
        <div id="server_status_wrapper">
            <i id="mwPointServeur"></i>
            <div class="mwDeuxLignes">
                <span id="landingPlayerLabel">Serveur</span>
                <span id="player_count">Recherche…</span>
            </div>
        </div>
        <div id="mwMilieu">
            <div id="mwEtatMod">
                <i class="mwRond mwVert"><svg viewBox="0 0 24 24" class="mwTrait"><path d="M5 12.5l4.4 4.4L19 7.4"/></svg></i>
                <div class="mwDeuxLignes">
                    <span id="mwEtatTitre">Prêt à jouer</span>
                    <span id="mwEtatDetail">Minecraft 1.21.11 · Fabric</span>
                </div>
            </div>
            <div id="launch_details">
                <div id="mwChargeHaut">
                    <span id="launch_details_text"><%- lang('landing.launchDetails') %></span>
                    <span id="launch_progress_label">0%</span>
                </div>
                <progress id="launch_progress" value="0" max="100"></progress>
            </div>
        </div>
        <div id="launch_content">
            <button id="launch_button">
                <span class="mwJouer"><%- lang('landing.launchButton') %></span>
                <span class="mwEnCours">EN COURS…</span>
            </button>
        </div>
    </footer>

    <!-- Fenêtre « Dernière étape » / erreurs du mode « launcher officiel » (remplie par mineworld-accueil.js) -->
    <div id="mwModale" hidden>
        <div id="mwModaleCarte" role="dialog" aria-modal="true"></div>
        <p id="mwModaleNote"></p>
    </div>

    <!-- Éléments d'origine de Helios, gardés cachés : landing.js et uibinder.js s'en servent encore. -->
    <div id="mwAncien" style="display: none;">
        <button id="server_selection_button"><%- lang('landing.launchButtonPlaceholder') %></button>
        <span id="mojang_status_icon">&#8226;</span>
        <div id="mojangStatusEssentialContainer"></div>
        <div id="mojangStatusNonEssentialContainer"></div>
        <button id="newsButton"><div id="newsButtonAlert" style="display: none;"></div></button>
        <div id="newsContainer">
            <div id="newsContent" article="-1" style="display: none;">
                <a id="newsArticleTitle" href="#"></a>
                <span id="newsArticleDate"></span>
                <span id="newsArticleAuthor"></span>
                <a href="#" id="newsArticleComments"></a>
                <button id="newsNavigateLeft"></button>
                <span id="newsNavigationStatus"></span>
                <button id="newsNavigateRight"></button>
                <div id="newsArticleContentScrollable"></div>
            </div>
            <div id="newsErrorContainer">
                <div id="newsErrorLoading"><span id="nELoadSpan"></span></div>
                <div id="newsErrorFailed" style="display: none;"><button id="newsErrorRetry"></button></div>
                <div id="newsErrorNone" style="display: none;"></div>
            </div>
        </div>
    </div>
    <script src="./assets/js/scripts/landing.js"></script>
    <script src="./assets/js/scripts/mineworld-accueil.js"></script>
</div>
